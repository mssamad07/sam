# ==========================================
# SAM CONFIGURATION — ENVIRONMENT TEMPLATE
# ==========================================
# Copy this file to .env to configure local environment variables.
# NEVER commit real API keys or sensitive secrets to version control.

# Application Information
APP_NAME=Sam
ENVIRONMENT=development
DEBUG=false

# IPC Server Networking (Phase 1 binds strictly to localhost)
HOST=127.0.0.1
PORT=8765
WS_PATH=/ws/ipc
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=20
WS_MAX_MESSAGE_SIZE=1048576

# Optional Authentication Token for IPC Clients
# If left empty, local loopback connections are unauthenticated in development
AUTH_TOKEN=

# Logging Settings
LOG_LEVEL=INFO

# Base Storage Directory
DATA_DIR=~/.sam

# ==========================================
# FUTURE PROVIDER PLACEHOLDERS (Phase 2+)
# ==========================================
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Safety & Permissions
REQUIRE_CONFIRMATION_FOR_TIER3=true
CONFIRMATION_TIMEOUT_SECONDS=60
